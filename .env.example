# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает (П7).

# Какой бэкенд LLM использовать: gigachat | ollama | fake
# fake — офлайн-заглушка: без сети и ключей, для отладки. Сдавать на ней нельзя.
LLM_BACKEND=ollama

# Сбер GigaChat: авторизационные данные из личного кабинета
GIGACHAT_CREDENTIALS=
GIGACHAT_MODEL=GigaChat
# Проверка TLS включена. При необходимости установите доверенный сертификат.
GIGACHAT_VERIFY_SSL=true

# Локальный инференс через Ollama (фолбэк, когда API недоступен)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=credit-qwen3:4b

# Токен сообщества VK для бота
VK_TOKEN=

# Доступный для записи кэш модели; команды запускайте из корня проекта
HF_HOME=.cache/huggingface
ANONYMIZED_TELEMETRY=False
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
TOKENIZERS_PARALLELISM=false
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
